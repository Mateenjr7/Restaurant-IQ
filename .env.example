# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime by AI Studio.
APP_URL="MY_APP_URL"

# PORT: Server listener port (defaults to 3000)
PORT=3000

# AUTH_SECRET: Cryptographic secret used to sign HMAC-SHA256 session tokens.
# In production (NODE_ENV=production), must be at least 32 characters long.
# In local development, automatically generates an ephemeral 256-bit secret if omitted.
AUTH_SECRET="your-secure-auth-secret-min-32-chars-long"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL access is server-only; Vite must never receive either URL.
# The Express application requires PostgreSQL mode; there is no JSON fallback.
PERSISTENCE_MODE=postgres

# MIGRATION_DATABASE_URL uses a privileged migration owner and is used only by
# explicit migration/import/provisioning commands, never by normal API traffic.
# Do not add SSL query parameters; the scripts use the configured CA below.
MIGRATION_DATABASE_URL="postgresql://postgres:[MIGRATION_PASSWORD]@[HOST]:5432/postgres"

# Official Supabase CA certificate downloaded from Database Settings > SSL Configuration.
# Relative paths are resolved from the project root when the scripts are run.
SUPABASE_CA_CERT_PATH="certs/prod-ca-2021.crt"

# RUNTIME_DB_PASSWORD is used only when explicitly provisioning the restricted
# restaurantiq_runtime login role. Use a unique password with at least 24 chars.
RUNTIME_DB_PASSWORD="replace-with-a-unique-random-password"

# DATABASE_URL must authenticate as restaurantiq_runtime after provisioning.
DATABASE_URL="postgresql://restaurantiq_runtime:[RUNTIME_PASSWORD]@[HOST]:5432/postgres"

# Write integration tests require an independently provisioned disposable
# database. Never set this to the shared application database.
TEST_DATABASE_URL=""
RESTAURANTIQ_TEST_DATABASE_DISPOSABLE=false
